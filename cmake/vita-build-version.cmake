file(READ "${SOURCE_DIR}/CMakeLists.txt" root_cmake)
string(REGEX MATCH "project\\(Lighthouse VERSION ([0-9]+)\\.([0-9]+)\\.([0-9]+)" version_match "${root_cmake}")
if(NOT version_match)
    message(FATAL_ERROR "Cannot find the Lighthouse project version")
endif()
set(CMAKE_PROJECT_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(CMAKE_PROJECT_VERSION_MINOR "${CMAKE_MATCH_2}")
set(CMAKE_PROJECT_VERSION_PATCH "${CMAKE_MATCH_3}")
set(words Alfa Bravo Charlie Delta Echo Foxtrot Golf Hotel India Juliett Kilo Lima Mike November Oscar Papa Quebec Romeo Sierra Tango Uniform Victor Whiskey Xray Yankee Zulu)
list(GET words ${CMAKE_PROJECT_VERSION_PATCH} PROJECT_PATCH_WORD)
set(PROJECT_BUILD_NAME "Split Rock ${PROJECT_PATCH_WORD}")
set(PROJECT_TEAM "")
execute_process(COMMAND git branch --show-current WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE CMAKE_PROJECT_GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git rev-parse --short=7 HEAD WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE CMAKE_PROJECT_GIT_COMMIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git describe --tags --abbrev=0 --exact-match HEAD WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE CMAKE_PROJECT_GIT_COMMIT_TAG OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
configure_file("${SOURCE_DIR}/src/port/build.c.in" "${OUTPUT}" @ONLY)
